  "records": [
    {
      "id": "PILOT-RECON-001",
      "interface": "reconciliation result",
      "required_fields": ["run_token", "cohort_token", "domain", "contract_id", "contract_version", "population_definition", "expected_equation", "measured_values", "difference", "tolerance", "acceptance_result", "evidence_hashes", "exception_refs", "approval_ref"]
    },
    {
      "id": "PILOT-RECON-002",
      "interface": "partition",
      "rule": "Every population member is assigned exactly one ordered primary bucket; secondary diagnostics do not add to the partition.",
      "required_difference": 0
    },
    {
      "id": "PILOT-RECON-003",
      "interface": "missing measurement",
      "rule": "A mandatory unmeasured value is blocked_not_measured, never passed.",
      "acceptance_values": ["passed", "failed", "blocked_not_measured", "not_applicable_with_rule"]
    },
    {
      "id": "PILOT-RECON-004",
      "interface": "evidence binding",
      "rule": "Every result binds source, target, contract, query, canonicalization, HMAC-key-version and result identities at one run/snapshot coordinate. Drift invalidates the result."
    },
    {
      "id": "PILOT-RECON-005",
      "interface": "classified nonzero",
      "rule": "A classified source-quality exception may be a nonzero primary bucket but never excuses a nonzero equation difference or safety assertion."
    },
    {
      "id": "PILOT-RECON-006",
      "interface": "insurance history",
      "rule": "All pilot insurance source rows reconcile through INS-REC-001 through INS-REC-015; every source row has provenance and each patient/provider group selects at most one current representation."
    },
    {
      "id": "PILOT-RECON-007",
      "interface": "idempotency and checkpoint",
      "rule": "Each successful atomic-stage outcome has exactly one compatible checkpoint and each checkpoint resolves to durable facts; unexplained partial state fails."
    },
    {
      "id": "PILOT-RECON-008",
      "interface": "phase boundary writes",
      "required_zero": ["phase2f_source_writes", "phase2f_target_writes", "dry_run_source_writes", "dry_run_target_writes"]
