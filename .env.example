APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local/testing diagnostics only. Production remains disabled by APP_ENV.
PERFORMANCE_PROFILING_ENABLED=false
PERFORMANCE_RESPONSE_HEADERS=false
PERFORMANCE_DETECT_LAZY_LOADING=false
PERFORMANCE_LOG_LAZY_LOADING=false
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment timing Phase 2 rollout. Legacy remains authoritative in both modes;
# observe only compares typed expectations and emits bounded diagnostics.
PAYMENT_TIMING_INTEGRATION_MODE=legacy
PAYMENT_TIMING_LOG_MISMATCHES=true
PAYMENT_TIMING_LOG_MATCHES=false
PAYMENT_TIMING_LOG_DEDUPLICATION_SECONDS=300

# Phase 9 visit financial clearance is safe-by-default. Remove the force flag
# only as part of an authorised activation through the admin settings workflow.
VISIT_FINANCIAL_CLEARANCE_MODE=disabled
VISIT_FINANCIAL_CLEARANCE_FORCE_DISABLED=true

# Insurance Verification � generic, provider-agnostic.
# Default driver used when an insurance provider has no verification_driver column value.
INSURANCE_VERIFICATION_DEFAULT=manual

# Per-provider credential bundles. Add one block per real provider keyed by
# the provider's verification_credentials_key. Examples (disabled by default):
# INSURANCE_NHIA_API_TOKEN=
# INSURANCE_NHIA_API_USERNAME=
# INSURANCE_NHIA_API_PASSWORD=
# INSURANCE_NHIA_API_TIMEOUT=10

PATIENT_ID_PREFIX=UHMS
PATIENT_ID_PATTERN='{PREFIX}-{SEQUENCE}/{YEAR}'
PATIENT_ID_SEQUENCE_LENGTH=6
PATIENT_ID_RESET_PERIOD=yearly

APP_COUNTRY_CODE=GH

# Classic UHMS migration foundation (Phase 3). Safe defaults keep the
# foundation disabled, dry-run only, and without commit/import authority.
LEGACY_MIGRATION_FOUNDATION_ENABLED=false
LEGACY_MIGRATION_FOUNDATION_SCHEMA_WRITES_ENABLED=false
LEGACY_MIGRATION_ALLOWED_ENVIRONMENTS=local,testing
LEGACY_MIGRATION_SOURCE_VERSION=10.4.32-MariaDB
LEGACY_MIGRATION_SOURCE_FINGERPRINT=
LEGACY_MIGRATION_TARGET_CONNECTION=
LEGACY_MIGRATION_TARGET_DATABASE=
LEGACY_MIGRATION_TARGET_VERSION=10.4.32-MariaDB
LEGACY_MIGRATION_TARGET_FINGERPRINT=
LEGACY_MIGRATION_TARGET_TABLE_COUNT=
LEGACY_MIGRATION_TARGET_COLUMN_COUNT=
LEGACY_MIGRATION_CONTRACT_BUNDLE_VERSION=phase-2f/2F.1.0
LEGACY_MIGRATION_HMAC_KEY_ID=
LEGACY_MIGRATION_HMAC_KEY_VERSION=
LEGACY_MIGRATION_KEY_REFERENCE_MANIFEST=
LEGACY_MIGRATION_KEY_REFERENCE_MANIFEST_HASH=
LEGACY_MIGRATION_KEY_ROTATION_AUTHORITY_REFERENCE=
LEGACY_MIGRATION_KEY_ROTATION_REASONS=
LEGACY_MIGRATION_PROTECTED_ACCESS_POLICY_REFERENCE=
LEGACY_MIGRATION_PROTECTED_ACCESS_CLASSIFICATION=
LEGACY_MIGRATION_TARGET_DRIVER=
LEGACY_MIGRATION_TARGET_PORT=
LEGACY_MIGRATION_TARGET_IDENTITY_CONTRACT_VERSION=
LEGACY_MIGRATION_TARGET_HOST_IDENTITY_REFERENCE=
LEGACY_MIGRATION_TARGET_TLS_CIPHER_REFERENCE=
LEGACY_MIGRATION_TARGET_TLS_PEER_IDENTITY_REFERENCE=
LEGACY_MIGRATION_TARGET_SERVER_IDENTITY_REFERENCE=
LEGACY_MIGRATION_TARGET_SERVER_ROLE=
LEGACY_MIGRATION_TARGET_NETWORK_IDENTITY_REFERENCE=
LEGACY_MIGRATION_TARGET_ATTESTATION_VERSION=
LEGACY_MIGRATION_FOUNDATION_SCHEMA_COORDINATE=
LEGACY_MIGRATION_CONFIGURATION_FINGERPRINT=
LEGACY_MIGRATION_TARGET_IDENTITY_APPROVAL_REFERENCE=
LEGACY_MIGRATION_TARGET_IDENTITY_KEY_REFERENCE=
LEGACY_MIGRATION_TARGET_IDENTITY_KEY_ID=
LEGACY_MIGRATION_TARGET_IDENTITY_KEY_VERSION=
LEGACY_MIGRATION_PHASE2F_POLICY_BUNDLE_HASH=
LEGACY_MIGRATION_PHASE2F_POLICY_APPROVAL_REFERENCE=
LEGACY_MIGRATION_PHASE2F_POLICY_MANIFEST=
LEGACY_MIGRATION_SOURCE_QUERY_MANIFEST_REFERENCE=
LEGACY_MIGRATION_TARGET_QUERY_MANIFEST_REFERENCE=
LEGACY_MIGRATION_SNAPSHOT_PERSISTENCE_AUTHORITY_REFERENCE=
LEGACY_MIGRATION_CAPTURE_TOOL_VERSION=
LEGACY_MIGRATION_RECOVERY_CONNECTION=
LEGACY_MIGRATION_RECOVERY_AUTHORITY_REFERENCE=
LEGACY_MIGRATION_RECOVERY_ACCESS_CLASSIFICATION=
LEGACY_MIGRATION_RECOVERY_RETENTION_CLASSIFICATION=
LEGACY_MIGRATION_RECOVERY_TRANSFORMATION_VERSION=
LEGACY_MIGRATION_EVALUATOR_BUNDLE_VERSION=
LEGACY_MIGRATION_SOURCE_RECORDER_REFERENCE=
LEGACY_MIGRATION_TARGET_RECORDER_REFERENCE=
LEGACY_MIGRATION_SIDE_EFFECT_RECORDER_REFERENCE=
LEGACY_MIGRATION_REPOSITORY_RECORDER_REFERENCE=
LEGACY_MIGRATION_ISOLATION_AUTHORITY_REFERENCE=
LEGACY_MIGRATION_QUEUE_BARRIER_REFERENCE=
LEGACY_MIGRATION_SCHEDULER_BARRIER_REFERENCE=
LEGACY_MIGRATION_NULL_SINK_REFERENCE=
LEGACY_MIGRATION_RETENTION_POLICY_REFERENCE=

# Dedicated DBA-provisioned Classic account. It must be limited to SELECT and
# metadata access on exact uuhms; never place real credentials in source control.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=uuhms
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
